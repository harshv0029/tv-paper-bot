+def _idxopt_hourly(df, now):
+    """(starts, opens/highs/closes, days) of COMPLETED hourly bars, IST-naive; None when the frame is unusable (bars
+    not on the NSE :15 grid, e.g. a UTC-naive fallback source - never guess the timezone)."""
+    if df is None or not len(df):
+        return None
+    idx = pd.to_datetime(df["Date"]) if "Date" in df.columns else pd.DatetimeIndex(df.index)
+    if getattr(idx, "tz", None) is not None:
+        idx = idx.tz_convert("Asia/Kolkata").tz_localize(None)
+    starts = list(idx)
+    keep = [i for i, s in enumerate(starts) if s + dt.timedelta(hours=1) <= now or
+            (s.strftime("%H:%M") == "15:15" and s.date() < now.date())]
+    if not keep:
+        return None
+    if any(starts[i].minute != 15 or not (9 <= starts[i].hour <= 15) for i in keep[-12:]):
+        return None
+    return {"start": [starts[i] for i in keep], "high": df["High"].to_numpy(float)[keep],
+            "close": df["Close"].to_numpy(float)[keep], "day": [starts[i].strftime("%Y-%m-%d") for i in keep]}
+
+
+def _idxopt_orb3(days, highs, closes, or_bars=3):
+    """Same rule as scripts/index_option_trigger_research.trig_orb: close above the high of the first or_bars bars of
+    the session, first break per day only."""
+    sig = [False] * len(closes)
+    start, fired, orh = 0, False, None
+    for i in range(len(closes)):
+        if i == 0 or days[i] != days[i - 1]:
+            start, fired, orh = i, False, None
+        pos = i - start
+        if pos == or_bars - 1:
+            orh = max(highs[start:i + 1])
+        elif pos >= or_bars and not fired and orh is not None and closes[i] > orh:
+            sig[i], fired = True, True
+    return sig
+
+
+def _idxopt_ema_cross_down(closes, fast=9, slow=21):
+    """EMA fast crosses above slow on 1/close (the replay's short mirror) = a cross DOWN on the real price."""
+    c = pd.Series(1.0 / pd.Series(closes, dtype=float))
+    f, s_ = c.ewm(span=fast, adjust=False).mean(), c.ewm(span=slow, adjust=False).mean()
+    return ((f > s_) & (f.shift(1) <= s_.shift(1))).fillna(False).tolist()
+
