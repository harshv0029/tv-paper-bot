+def _idxopt_future(underlying, day):
+    """Near-month future contract for the volume samples, resolved once per IST day. None when not resolvable."""
+    hit = _IDXOPT_STATE["futures"].get(underlying)
+    if hit and hit[0] == day:
+        return hit[1]
+    fut = None
+    try:
+        fut, _err = nse_fo_chain.select_nse_future(underlying)
+    except Exception as e:  # noqa: BLE001
+        print(f"[IDXOPT] future resolve {underlying} failed (non-fatal): {str(e)[:120]}")
+    _IDXOPT_STATE["futures"][underlying] = (day, fut)
+    return fut
+
