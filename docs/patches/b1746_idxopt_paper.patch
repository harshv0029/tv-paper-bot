+def _idxopt_atm(underlying, right):
+    """(row, None) for the nearest-expiry ATM contract of `right` with a live premium, or (None, skip reason)."""
+    rows = _fno_chain_fetch(underlying)
+    cands = [r for r in rows if _fno_momo_opt_type(r.get("optionType")) == right and _fno_num(r.get("lastPrice")) > 0]
+    spot = next((_fno_num(r.get("underlyingValue")) for r in cands if _fno_num(r.get("underlyingValue")) > 0), 0.0)
+    if not cands or spot <= 0:
+        return None, "skipped_no_chain"
+    return min(cands, key=lambda r: abs(_fno_num(r.get("strikePrice")) - spot)), None
+
