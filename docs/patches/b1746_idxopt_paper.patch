+def _idxopt_futvol_gate(conn, underlying, day, boundary):
+    """(ok, reason, detail): the hour ending at `boundary` today vs the mean of up to 20 earlier full hours. Fails
+    closed on a missing sample or < IDXOPT_FUTVOL_MIN_BARS of history. The 15:15-15:30 stub hour is never used."""
+    rows = conn.execute("SELECT day, boundary, cum_volume FROM idxopt_futvol WHERE underlying = ? AND day <= ? "
+                        "ORDER BY day, boundary", (underlying, day)).fetchall()
+    by_day = {}
+    for r in rows:
+        by_day.setdefault(r["day"], {})[r["boundary"]] = float(r["cum_volume"])
+    bars = []  # (day, boundary, volume) in time order
+    for d in sorted(by_day):
+        cum = by_day[d]
+        for k, b in enumerate(IDXOPT_BOUNDARIES):
+            prev = 0.0 if k == 0 else cum.get(IDXOPT_BOUNDARIES[k - 1])
+            if b in cum and prev is not None and cum[b] >= prev:
+                bars.append((d, b, cum[b] - prev))
+    cur = next((x for x in bars if x[0] == day and x[1] == boundary), None)
+    if cur is None:
+        return False, "skipped_futvol_missing_sample", {}
+    hist = [x[2] for x in bars if (x[0], x[1]) < (day, boundary)][-IDXOPT_FUTVOL_LOOKBACK:]
+    if len(hist) < IDXOPT_FUTVOL_MIN_BARS:
+        return False, "skipped_futvol_warmup", {"hist_bars": len(hist)}
+    avg = sum(hist) / len(hist)
+    det = {"bar_volume": cur[2], "avg_volume": round(avg, 1), "hist_bars": len(hist)}
+    return (True, None, det) if cur[2] > avg else (False, "skipped_futvol_below_avg", det)
+
