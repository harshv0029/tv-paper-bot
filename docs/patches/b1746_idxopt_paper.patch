+                    acts.append({"action": "entry", "tag": v["tag"], "contract": cand["contract"], "price": px,
+                                 "reason": reason})
+                    print(f"[IDXOPT] PAPER entry {v['tag']} {cand['contract']} @ {px} ({reason})")
+            if scan["skip"]:
