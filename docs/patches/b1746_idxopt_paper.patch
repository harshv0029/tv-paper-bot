+def _idxopt_signal_bar(bars, trigger):
+    """(bar_end datetime, True) when the LAST completed hourly bar fired `trigger`, else (bar_end, False)."""
+    if trigger == "orb3":
+        sig = _idxopt_orb3(bars["day"], list(bars["high"]), list(bars["close"]))
+    else:
+        sig = _idxopt_ema_cross_down(list(bars["close"]))
+    return bars["start"][-1] + dt.timedelta(hours=1), bool(sig[-1])
+
