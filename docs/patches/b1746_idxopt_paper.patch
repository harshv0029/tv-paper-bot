+def _idxopt_manage(conn, row, v, now, now_ts, quote) -> dict | None:
+    """Exit checks for one open paper row: forced 15:13, trailing SL (fill at the resting stop), 1-hour time exit."""
+    price = 0.0
+    try:
+        price = _fno_num(quote(row["contract"], row["underlying"]))
+    except Exception:
+        price = 0.0
+    price = price if price > 0 else (row["last_price"] or row["entry_price"])
+    mins = now.hour * 60 + now.minute
+    if mins >= IDXOPT_FORCE_EXIT_MIN:
+        return _fno_momo_close(conn, row, price, "forced_exit_1513", now_ts, observed=price)
+    if price <= row["stop_price"]:
+        return _fno_momo_close(conn, row, row["stop_price"], "trailing_sl", now_ts, observed=price)
+    if v["max_hold_s"] and now_ts - (row["opened_ts"] or now_ts) >= v["max_hold_s"]:
+        return _fno_momo_close(conn, row, price, "time_exit_60min", now_ts, observed=price)
+    peak = max(row["peak_price"], price)
+    stop = row["stop_price"]
+    if peak >= row["entry_price"] * (1.0 + v["arm"]):
+        stop = max(stop, round(peak * (1.0 - v["trail"]), 4))
+    trough, path = _fno_momo_path_add(row, price, now_ts)
+    conn.execute("UPDATE fno_momo_paper_trades SET peak_price = ?, stop_price = ?, last_price = ?, last_ts = ?, "
+                 "trough_price = ?, price_path = ? WHERE id = ?", (peak, stop, price, now_ts, trough, path, row["id"]))
+    return None
+
