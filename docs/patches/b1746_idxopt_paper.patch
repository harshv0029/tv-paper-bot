+            if not (IDXOPT_FIRST_ENTRY_MIN <= mins <= IDXOPT_LAST_ENTRY_MIN):
+                continue
+            bars = (bars_by_sym or {}).get(sym) if bars_by_sym is not None else _idxopt_hourly(
+                fetch_ohlc(sym, "60d", "1h"), now)
+            if not bars or len(bars["close"]) < 30:
