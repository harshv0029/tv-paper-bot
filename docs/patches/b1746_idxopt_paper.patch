+def _idxopt_step(conn, now=None, now_ts=None, bars_by_sym=None, quote=None, chain=None) -> list:
+    """B-1746 one pass (PAPER ONLY): manage every open idxopt row, then act on fresh hourly signals."""
+    now = now or ist_now()
