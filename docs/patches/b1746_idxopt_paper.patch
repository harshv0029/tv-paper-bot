+            bar_end, fired = _idxopt_signal_bar(bars, v["trigger"])
+            if not fired or not (0 <= (now - bar_end).total_seconds() <= IDXOPT_FRESH_S):
+                continue
+            key = f"{v['tag']}|{u}|{bar_end:%Y-%m-%d %H:%M}"
+            if _IDXOPT_STATE["last_signal"].get(key) or conn.execute(
+                    "SELECT 1 FROM fno_momo_paper_trades WHERE tag = ? AND underlying = ? AND day = ? AND entry_meta "
+                    "LIKE ?", (v["tag"], u, day, f'%"signal_bar": "{bar_end:%H:%M}"%')).fetchone():
+                continue  # this bar already acted on (in memory, or a row restored after a restart)
