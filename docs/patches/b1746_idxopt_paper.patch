+def _idxopt_sample_futvol(conn, now, quote_rows=None) -> int:
+    """At each hourly boundary (first 5 min), stores the near-month future's cumulative day volume once. Returns rows."""
+    day, n = now.strftime("%Y-%m-%d"), 0
+    for b in IDXOPT_BOUNDARIES:
+        bt = dt.datetime.combine(now.date(), dt.time(int(b[:2]), int(b[3:])))
+        if not (0 <= (now - bt).total_seconds() < IDXOPT_SAMPLE_WINDOW_S):
+            continue
+        for u in IDXOPT_UNDERLYINGS.values():
+            if conn.execute("SELECT 1 FROM idxopt_futvol WHERE underlying = ? AND day = ? AND boundary = ?",
+                            (u, day, b)).fetchone():
+                continue
+            fut = _idxopt_future(u, day)
+            if not fut:
+                continue
+            tok = str(fut["instrument_token"])
+            q = (quote_rows or _fno_kotak_quote_rows)([tok], fut["exchange_segment"]).get(tok) or {}
+            vol = _fno_num(q.get("last_volume"))
+            if vol > 0:
+                conn.execute("INSERT OR IGNORE INTO idxopt_futvol (underlying, day, boundary, ts, cum_volume) "
+                             "VALUES (?, ?, ?, ?, ?)", (u, day, b, time.time(), vol))
+                n += 1
+    if n:
+        cutoff = (now.date() - dt.timedelta(days=IDXOPT_FUTVOL_KEEP_DAYS)).isoformat()
+        conn.execute("DELETE FROM idxopt_futvol WHERE day < ?", (cutoff,))
+        conn.commit()
+    return n
+
