+                                  _fno_num(cand.get("pChange")), reason, json.dumps(meta, default=str), px,
+                                  json.dumps([[round(now_ts, 1), px]])))
+                    scan.update(entered=True, candidate={"contract": cand["contract"], "underlying": u,
